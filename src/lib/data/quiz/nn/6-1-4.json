{"questions":[{"question":"Kva tyder éin prosent (1 %)?","options":["Éin hundredel","Éin tidel","Eitt heilt","Éin tusendel"],"explanation":"Prosent tyder «per hundre»: 1 % = 1/100 av noko."},{"question":"Kva er 10 % av 250 kr?","options":["25 kr","2,50 kr","10 kr","125 kr"],"explanation":"10 % finn vi ved å dele på 10: 250 ÷ 10 = 25 kr."},{"question":"Kva er 30 % av 150?","options":["45","30","50","120"],"explanation":"30 % = 0,3 og 0,3 · 150 = 45. Eller: 10 % er 15, så 30 % er 3 · 15 = 45."},{"question":"Kva er 50 % av 86?","options":["43","50","36","172"],"explanation":"50 % er halvparten: 86 ÷ 2 = 43."},{"question":"I ein klasse med 20 elevar bruker 25 % briller. Kor mange elevar er det?","options":["5 elevar","4 elevar","10 elevar","25 elevar"],"explanation":"25 % er ein firedel: 20 ÷ 4 = 5 elevar."}],"_meta":{"sourceHash":"b9680c399b6decdd","translatedAt":"2026-06-21T22:11:14.175Z","model":"claude-code-agent","strings":22,"tm":{"82e50f52f3615948":"Kva tyder éin prosent (1 %)?","0e62edb35bfdfd2a":"Éin hundredel","1ab0e18df5118762":"Éin tidel","6b009576c54f4d02":"Eitt heilt","946e2ee77ba05a6e":"Éin tusendel","4a8b49a2a69c37a9":"Prosent tyder «per hundre»: 1 % = 1/100 av noko.","2340d925d6a5a19a":"Kva er 10 % av 250 kr?","f73ebc798b688be1":"25 kr","9709f6064c02ec29":"2,50 kr","2b06b4069cc4e4f4":"10 kr","cac0a26fe16da3ac":"125 kr","4f1b3ef2edb5a2fe":"10 % finn vi ved å dele på 10: 250 ÷ 10 = 25 kr.","8e59e5468cebbdd0":"Kva er 30 % av 150?","f5d67945aca971f3":"30 % = 0,3 og 0,3 · 150 = 45. Eller: 10 % er 15, så 30 % er 3 · 15 = 45.","8c57580b88438506":"Kva er 50 % av 86?","fde9c5a15ecf4092":"50 % er halvparten: 86 ÷ 2 = 43.","c50278806697509f":"I ein klasse med 20 elevar bruker 25 % briller. Kor mange elevar er det?","a83ad0562601152e":"5 elevar","533ffa365478427b":"4 elevar","347de0a2f7a9a5d0":"10 elevar","f6952286cabb6f20":"25 elevar","a7566f32a541e057":"25 % er ein firedel: 20 ÷ 4 = 5 elevar."}}}