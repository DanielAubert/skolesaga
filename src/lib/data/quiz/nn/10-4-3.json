{"questions":[{"question":"Kva kjenneteiknar ein vektor?","options":["Han har både lengd og retning","Han har berre verdi","Han er alltid positiv","Han er eit heiltal"],"explanation":"Ein vektor har både lengd (storleik) og retning."},{"question":"Finn vektoren frå $A(1, 2)$ til $B(4, 6)$.","options":["$[3, 4]$","$[5, 8]$","$[3, 8]$","$[4, 6]$"],"explanation":"$\\vec{AB} = [4 - 1, 6 - 2] = [3, 4]$."},{"question":"Kva er lengda til vektoren $[3, 4]$?","options":["$5$","$7$","$25$","$12$"],"explanation":"$|\\vec{v}| = \\sqrt{3^2 + 4^2} = \\sqrt{25} = 5$."},{"question":"Gitt $\\vec{a} = [3, 2]$ og $\\vec{b} = [1, 4]$. Finn $\\vec{a} + \\vec{b}$.","options":["$[4, 6]$","$[2, -2]$","$[3, 8]$","$[4, 8]$"],"explanation":"Legg saman komponentane: $[3 + 1, 2 + 4] = [4, 6]$."},{"question":"Gitt $\\vec{v} = [2, -3]$. Kva er $3\\vec{v}$?","options":["$[6, -9]$","$[5, 0]$","$[6, 9]$","$[2, -9]$"],"explanation":"Skalarmultiplikasjon: $3 \\cdot [2, -3] = [6, -9]$."}],"_meta":{"sourceHash":"da04b74bcbf654bd","translatedAt":"2026-06-21T22:01:37.729Z","model":"claude-code-agent","strings":14,"tm":{"5ceae8398c2c1499":"Kva kjenneteiknar ein vektor?","233c880be3f15e99":"Han har både lengd og retning","bcbda33820102f9d":"Han har berre verdi","ac404eee933fd51d":"Han er alltid positiv","6c78206b443b8f0c":"Han er eit heiltal","38d266454cce5099":"Ein vektor har både lengd (storleik) og retning.","ccf7b9633c10411e":"Finn vektoren frå $A(1, 2)$ til $B(4, 6)$.","0047e7aa9b0c6e0e":"$\\vec{AB} = [4 - 1, 6 - 2] = [3, 4]$.","57e79827a8405108":"Kva er lengda til vektoren $[3, 4]$?","7ab2c674ede45ab0":"$|\\vec{v}| = \\sqrt{3^2 + 4^2} = \\sqrt{25} = 5$.","42aca199581d2f77":"Gitt $\\vec{a} = [3, 2]$ og $\\vec{b} = [1, 4]$. Finn $\\vec{a} + \\vec{b}$.","6ad36d8de46b93d3":"Legg saman komponentane: $[3 + 1, 2 + 4] = [4, 6]$.","91a3244d2d4d763f":"Gitt $\\vec{v} = [2, -3]$. Kva er $3\\vec{v}$?","c1b35d07a92d2b68":"Skalarmultiplikasjon: $3 \\cdot [2, -3] = [6, -9]$."}}}