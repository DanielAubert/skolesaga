# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=http://localhost:3000

# OAuth (valgfritt)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FEIDE_CLIENT_ID=
FEIDE_CLIENT_SECRET=

# AI-retting av prøver
ANTHROPIC_API_KEY=your_anthropic_api_key

# Analytics (valgfritt)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AI-sensor (KI-vurdering av besvarelser) — SKJULT som standard.
# Slå på med begge flaggene + Anthropic-nøkkel. Se docs/AI-SENSOR.md.
AI_SENSOR_ENABLED=false
NEXT_PUBLIC_AI_SENSOR_ENABLED=false
# AI_SENSOR_MODEL=claude-haiku-4-5-20251001
# Fasit-mur (Pluss, målt tilgang til løsningsforslag) — SKJULT som standard.
NEXT_PUBLIC_FASIT_MUR_ENABLED=false
